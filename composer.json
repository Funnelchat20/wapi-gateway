{
  "name": "funnelchat20/wapi-gateway",
  "description": "WAPI Gateway: librería Composer para integrar ZApi, UAZAPI, Funapi y Meta con webhooks automáticos",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^11.0|^12.0",
    "guzzlehttp/guzzle": "^7.2",
    "spatie/laravel-data": "^3.11|^4.0",
    "sentry/sentry-laravel": "^4.7"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5|^11.0",
    "orchestra/testbench": "^9.0|^10.0"
  },
  "autoload": {
    "psr-4": {
      "Funnelchat\\WapiGateway\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Funnelchat\\WapiGateway\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Funnelchat\\WapiGateway\\Providers\\WapiServiceProvider",
        "Funnelchat\\WapiGateway\\Providers\\WhatsAppServiceProvider",
        "Funnelchat\\WapiGateway\\Providers\\WhatsAppInstanceServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
